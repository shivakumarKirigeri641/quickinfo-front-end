# Base URL of quickinfo-back-end including its /api prefix.
# Leave as /api in development: Vite proxies it to VITE_PROXY_TARGET.
# For production set the full URL, e.g. https://api.example.com/api
VITE_API_BASE=/api

# Must match SECRET_KEY in quickinfo-back-end/.env (response decryption).
VITE_SECRET_KEY=

# Development only: where the Vite dev server forwards /api calls.
VITE_PROXY_TARGET=http://localhost:7788
