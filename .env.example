# Base URL of quickinfo-back-end including its /api prefix.
# Leave as /api in development: Vite proxies it to VITE_PROXY_TARGET.
# For production set the full URL, e.g. https://api.example.com/api
VITE_API_BASE=/api

# Must match SECRET_KEY in quickinfo-back-end/.env (response decryption).
VITE_SECRET_KEY=

# Development only: where the Vite dev server forwards /api calls.
VITE_PROXY_TARGET=http://localhost:7788

# ── Business contact details (Contact section and footer) ──
# Must match the Meta business portfolio and your registration documents.
# Any field left empty is hidden.
VITE_BUSINESS_LEGAL_NAME=ServerPe App Solutions
VITE_BUSINESS_EMAIL=support@quickinfo.in
# Digits with country code, e.g. 919876543210
VITE_BUSINESS_PHONE=
# Use | for line breaks, e.g. No. 12, 1st Main|Indiranagar|Bangalore 560038, Karnataka
VITE_BUSINESS_ADDRESS=
# e.g. Mon to Sat, 10 AM to 6 PM
VITE_BUSINESS_HOURS=
